# Dependencies
node_modules/
.pnpm-store/

# Build outputs
dist/
build/
.next/
out/
*.tsbuildinfo

# Environment
# Patrón amplio a propósito: un `.env.backup` o `.env.prod` no matcheaba las
# reglas viejas y podía commitearse con secretos adentro.
.env*
!.env.example

# Logs
logs/
*.log
npm-debug.log*
pnpm-debug.log*

# IDE
.vscode/
.idea/
*.swp
.DS_Store

# Test
coverage/
.nyc_output/
playwright-report/
test-results/

# Prisma
apps/api/prisma/migrations/dev.db*
# El seed se ejecuta con `tsx prisma/seed.ts`; los compilados no los usa nadie.
apps/api/prisma/seed.js
apps/api/prisma/seed.js.map
apps/api/prisma/seed.d.ts
apps/api/prisma/seed.d.ts.map

# Docker
docker-data/

# Misc
*.pem
.turbo/

# DB dumps (no se commitean — se transfieren por fuera del repo)
*.dump
*.sql.gz
# dumps sueltos en la raíz (las migraciones viven en apps/api/prisma/migrations)
/tienda3d_dump_*.sql
